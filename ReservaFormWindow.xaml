<Window x:Class="Trabajo_IPO.ReservaFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reserva" Width="560" Height="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TituloTextBlock" Text="Nueva reserva" FontSize="24"
                   FontWeight="Bold" Foreground="#17324D" Margin="0,0,0,22"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Alojamiento *" VerticalAlignment="Center"/>
            <ComboBox x:Name="AlojamientoComboBox" Grid.Column="1" Height="30"
                      DisplayMemberPath="Codigo"
                      ToolTip="Seleccione el alojamiento que ocupará el cliente"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Fecha de entrada *" VerticalAlignment="Center"/>
            <DatePicker x:Name="EntradaDatePicker" Grid.Column="1" Height="30"
                        ToolTip="Seleccione el primer día de la estancia"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Fecha de salida *" VerticalAlignment="Center"/>
            <DatePicker x:Name="SalidaDatePicker" Grid.Column="1" Height="30"
                        ToolTip="Seleccione el día posterior al último día de la estancia"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Persona que reserva *" VerticalAlignment="Center"/>
            <TextBox x:Name="ClienteTextBox" Grid.Column="1" Height="30"
                     ToolTip="Nombre y apellidos de la persona responsable de la reserva"/>
        </Grid>
        <Grid Grid.Row="5" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Número de ocupantes *" VerticalAlignment="Center"/>
            <TextBox x:Name="OcupantesTextBox" Grid.Column="1" Height="30"
                     ToolTip="Número de personas que ocuparán el alojamiento"/>
        </Grid>
        <TextBlock Grid.Row="6" Text="La fecha de salida debe ser posterior a la fecha de entrada."
                   Foreground="#52616B" TextWrapping="Wrap" Margin="170,0,0,10"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="100" Height="34" Margin="0,0,10,0"
                    IsCancel="True" Click="Cancelar_Click"
                    ToolTip="Cerrar sin guardar cambios"/>
            <Button Content="Guardar" Width="110" Height="34" Background="#2E7D32"
                    Foreground="White" FontWeight="Bold" IsDefault="True"
                    Click="Guardar_Click" ToolTip="Validar y guardar la reserva"/>
        </StackPanel>
    </Grid>
</Window>
