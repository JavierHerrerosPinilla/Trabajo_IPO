<Window x:Class="Trabajo_IPO.AlojamientoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alojamiento" Width="520" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TituloTextBlock" Text="Nuevo alojamiento" FontSize="24"
                   FontWeight="Bold" Foreground="#17324D" Margin="0,0,0,22"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Código *" VerticalAlignment="Center"/>
            <TextBox x:Name="CodigoTextBox" Grid.Column="1" Height="30"
                     ToolTip="Código único, por ejemplo P-03 o B-08"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Tipo *" VerticalAlignment="Center"/>
            <ComboBox x:Name="TipoComboBox" Grid.Column="1" Height="30"
                      SelectionChanged="TipoComboBox_SelectionChanged"
                      ToolTip="Seleccione si el alojamiento es una parcela o un bungalow">
                <ComboBoxItem Content="Parcela"/>
                <ComboBoxItem Content="Bungalow"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Capacidad *" VerticalAlignment="Center"/>
            <TextBox x:Name="CapacidadTextBox" Grid.Column="1" Height="30"
                     ToolTip="Número máximo de personas"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Precio por noche *" VerticalAlignment="Center"/>
            <TextBox x:Name="PrecioTextBox" Grid.Column="1" Height="30"
                     ToolTip="Precio en euros por noche"/>
        </Grid>
        <Grid Grid.Row="5" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Ubicación" VerticalAlignment="Center"/>
            <TextBox x:Name="UbicacionTextBox" Grid.Column="1" Height="30"
                     ToolTip="Zona del camping en la que se encuentra"/>
        </Grid>
        <StackPanel Grid.Row="6">
            <CheckBox x:Name="SetosCheckBox" Content="Delimitada por setos"
                      Margin="155,0,0,10" ToolTip="Indica si la parcela está delimitada por setos"/>
            <CheckBox x:Name="WifiCheckBox" Content="Dispone de Wi-Fi"
                      Margin="155,0,0,10" ToolTip="Indica si el bungalow dispone de conexión Wi-Fi"/>
        </StackPanel>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="100" Height="34" Margin="0,0,10,0"
                    IsCancel="True" Click="Cancelar_Click"
                    ToolTip="Cerrar sin guardar cambios"/>
            <Button Content="Guardar" Width="110" Height="34" Background="#2E7D32"
                    Foreground="White" FontWeight="Bold" IsDefault="True"
                    Click="Guardar_Click" ToolTip="Validar y guardar el alojamiento"/>
        </StackPanel>
    </Grid>
</Window>
