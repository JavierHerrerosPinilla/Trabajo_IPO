<Window x:Class="Trabajo_IPO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión del complejo turístico" Height="720" Width="1180"
        MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17324D" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="COMPLEJO TURÍSTICO" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Panel de gestión" Foreground="#C8D9E8" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,18,0">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#F2B134" Margin="0,0,12,0">
                        <Grid>
                            <Image Source="{Binding FotoPerfil}" Stretch="UniformToFill" ToolTip="Foto de perfil del gestor"/>
                            <TextBlock Text="G" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#17324D"/>
                        </Grid>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding NombreCompleto}" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Rol}" Foreground="#C8D9E8" FontSize="12"/>
                        <TextBlock Text="{Binding UltimoAcceso, StringFormat=Último acceso: {0:dd/MM/yyyy HH:mm}}" Foreground="#C8D9E8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="FuenteGrandeToggleButton" Content="A+" Width="46" Height="32"
                                  Margin="0,0,8,0" Click="FuenteGrandeToggleButton_Click"
                                  ToolTip="Alternar entre tamaño de fuente normal y grande"/>
                    <Button Content="Ayuda" Width="70" Height="32" Click="Ayuda_Click"
                            ToolTip="Abrir la ayuda y la información de autoría"/>
                </StackPanel>
            </Grid>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="Datos de demostración: los cambios se mantienen durante esta sesión."/>
        </StatusBar>
        <TabControl Margin="20" FontSize="14">
            <TabItem Header="Alojamientos">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="＋ Añadir alojamiento" Width="155" Height="32" Margin="0,0,8,0"
                                Click="AnadirAlojamiento_Click" ToolTip="Crear una nueva parcela o bungalow"/>
                        <Button Content="✎ Modificar" Width="105" Height="32" Margin="0,0,8,0"
                                Click="ModificarAlojamiento_Click" ToolTip="Modificar el alojamiento seleccionado"/>
                        <Button Content="🗑 Eliminar" Width="105" Height="32" Click="EliminarAlojamiento_Click"
                                ToolTip="Eliminar parcela o bungalow seleccionado"/>
                    </StackPanel>
                    <DataGrid x:Name="AlojamientosGrid" Grid.Row="1" ItemsSource="{Binding Alojamientos}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="130"/>
                            <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="*"/>
                            <DataGridTextColumn Header="Capacidad" Binding="{Binding Capacidad}" Width="85"/>
                            <DataGridTextColumn Header="Precio/noche" Binding="{Binding PrecioNoche, StringFormat={}{0:C}}" Width="110"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Reservas">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="＋ Añadir reserva" Width="135" Height="32" Margin="0,0,8,0"
                                Click="AnadirReserva_Click" ToolTip="Añadir reserva para un cliente"/>
                        <Button Content="✎ Modificar" Width="105" Height="32" Margin="0,0,8,0"
                                Click="ModificarReserva_Click" ToolTip="Modificar la reserva seleccionada"/>
                        <Button Content="🗑 Cancelar reserva" Width="140" Height="32" Click="EliminarReserva_Click"
                                ToolTip="Cancelar la reserva seleccionada"/>
                    </StackPanel>
                    <DataGrid x:Name="ReservasGrid" Grid.Row="1" ItemsSource="{Binding Reservas}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="85"/>
                            <DataGridTextColumn Header="Alojamiento" Binding="{Binding Alojamiento}" Width="105"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                            <DataGridTextColumn Header="Entrada" Binding="{Binding Entrada, StringFormat={}{0:dd/MM/yyyy}}" Width="105"/>
                            <DataGridTextColumn Header="Salida" Binding="{Binding Salida, StringFormat={}{0:dd/MM/yyyy}}" Width="105"/>
                            <DataGridTextColumn Header="Personas" Binding="{Binding Ocupantes}" Width="80"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Empleados">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="＋ Añadir empleado" Width="140" Height="32" ToolTip="Registrar un nuevo guía o monitor"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Empleados}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="130"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="110"/>
                            <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="190"/>
                            <DataGridTextColumn Header="Idiomas" Binding="{Binding Idiomas}" Width="150"/>
                            <DataGridTextColumn Header="Disponibilidad" Binding="{Binding Disponibilidad}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Actividades">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="＋ Añadir actividad" Width="145" Height="32" ToolTip="Programar una nueva actividad de verano"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Actividades}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Actividad" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Monitor" Binding="{Binding Monitor}" Width="180"/>
                            <DataGridTextColumn Header="Horario" Binding="{Binding Horario}" Width="180"/>
                            <DataGridTextColumn Header="Destinatarios" Binding="{Binding Destinatarios}" Width="120"/>
                            <DataGridTextColumn Header="Cupo máximo" Binding="{Binding CupoMaximo}" Width="100"/>
                            <DataGridTextColumn Header="Precio/hora" Binding="{Binding PrecioHora, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="Zona" Binding="{Binding Zona}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
