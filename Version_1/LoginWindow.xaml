<Window x:Class="Trabajo_IPO.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso al complejo turístico" Height="535" Width="490"
        MinHeight="500" MinWidth="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource AppBgBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="F1: Ayuda" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" FontSize="12"/>
            <Button Content="? Ayuda" Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right" Click="Ayuda_Click"
                    ToolTip="Abrir la guía rápida e información de autoría (F1)"/>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                CornerRadius="8" Padding="28">
            <StackPanel>
                <Image x:Name="LogoImage"
                       Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,10"
                       ToolTip="Complejo Turístico Rural"/>

                <TextBlock Text="Complejo Turístico Rural" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource HeaderBgBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Acceso para personal de gestión" Margin="0,4,0,20"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>

                <TextBlock FontWeight="SemiBold" Margin="0,0,0,5">
                    <Run Text="Usuario"/>
                    <Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
                </TextBlock>
                <TextBox x:Name="UsuarioTextBox" Height="36" Margin="0,0,0,14"
                         TextChanged="Campos_TextChanged"
                         ToolTip="Identificador de gestor (ej. admin, javier o recepcion)"/>

                <TextBlock FontWeight="SemiBold" Margin="0,0,0,5">
                    <Run Text="Contraseña"/>
                    <Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
                </TextBlock>
                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="ContrasenaBox" Height="36"
                                 PasswordChanged="ContrasenaBox_PasswordChanged"
                                 ToolTip="Introduzca su clave de acceso"/>
                    <TextBox x:Name="ContrasenaVisibleTextBox" Height="36" Visibility="Collapsed"
                             TextChanged="ContrasenaVisibleTextBox_TextChanged"
                             ToolTip="Contraseña visible"/>
                </Grid>

                <CheckBox x:Name="MostrarContrasenaCheckBox" Content="Mostrar contraseña"
                          Margin="0,0,0,14"
                          Checked="MostrarContrasenaCheckBox_Changed"
                          Unchecked="MostrarContrasenaCheckBox_Changed"
                          ToolTip="Muestra u oculta los caracteres de la contraseña"/>

                <!-- Mensaje de error inline junto al formulario (Nielsen H9 + visión periférica) -->
                <Border x:Name="ErrorBorder" Visibility="Collapsed"
                        Background="{DynamicResource DangerSoftBrush}"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕ " FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock x:Name="ErrorTextBlock" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Salir" Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Click="Salir_Click" ToolTip="Cerrar la aplicación (pide confirmación)"/>
                    <Button Content="Limpiar" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                            Click="Limpiar_Click" ToolTip="Borrar el usuario y la contraseña"/>
                    <Button Content="Acceder" Grid.Column="4" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" Click="IniciarSesion_Click"
                            ToolTip="Validar credenciales y abrir la ventana principal"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
