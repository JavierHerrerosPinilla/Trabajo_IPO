<Application x:Class="Trabajo_IPO.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Trabajo_IPO"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <local:EstadoToBackgroundConverter x:Key="EstadoBgConverter"/>
            <local:EstadoToForegroundConverter x:Key="EstadoFgConverter"/>
            <local:EstadoToIconConverter x:Key="EstadoIconConverter"/>
            <local:ImagePathConverter x:Key="ImagePathConverter"/>
            <local:NullOrEmptyToVisibilityConverter x:Key="NullToVisibilityConverter"/>

            <!-- Tamaños dinámicos para adaptación accesible -->
            <sys:Double x:Key="AppFontSize">13.5</sys:Double>
            <sys:Double x:Key="TitleFontSize">20</sys:Double>
            <sys:Double x:Key="SmallFontSize">11.5</sys:Double>

            <!-- Paleta corporativa controlada (4-7 colores semánticos IPO) -->
            <SolidColorBrush x:Key="AppBgBrush" Color="#F5F7FA"/>
            <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="HeaderBgBrush" Color="#17324D"/>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#1E6091"/>
            <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E5EFF7"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#C62828"/>
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEA"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#B26A00"/>
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4E5"/>
            <SolidColorBrush x:Key="TextMainBrush" Color="#1F2933"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#52616B"/>
            <SolidColorBrush x:Key="BorderBrushSoft" Color="#D1D8E0"/>
            <SolidColorBrush x:Key="TableAltRowBrush" Color="#F8FAFC"/>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource AppBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            </Style>

            <Style TargetType="GroupBox">
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource HeaderBgBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
                <Setter Property="BorderBrush" Value="#B8C4D0"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
                <Setter Property="BorderBrush" Value="#B8C4D0"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="BaseButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.78"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#164A70"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1B5E20"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            </Style>

            <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="#254E77"/>
                <Setter Property="BorderBrush" Value="#46739E"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10,5"/>
            </Style>
            <Style TargetType="ToggleButton">
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#F2B134"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#F2B134"/>
                                    <Setter Property="Foreground" Value="#17324D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowBackground" Value="{DynamicResource CardBgBrush}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource TableAltRowBrush}"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F5"/>
                <Setter Property="RowHeight" Value="36"/>
                <Setter Property="ColumnHeaderHeight" Value="38"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#EAEFF5"/>
                <Setter Property="Foreground" Value="#17324D"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#FFFDE7"/>
                <Setter Property="Foreground" Value="#1F2933"/>
                <Setter Property="BorderBrush" Value="#D4B106"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
