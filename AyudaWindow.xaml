<Window x:Class="Trabajo_IPO.AyudaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayuda y autoría" Height="560" Width="720"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock Text="Ayuda y autoría" FontSize="28" FontWeight="Bold" Foreground="#17324D"/>
            <TextBlock Text="Guía rápida para utilizar el prototipo" Margin="0,6,0,22" Foreground="#52616B"/>
            <GroupBox Header="Guía rápida" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="• Alojamientos: consulte, añada, modifique o elimine parcelas y bungalows." TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="• Reservas: consulte las estancias y sus datos de cliente desde la pestaña Reservas." TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="• Empleados: consulte los guías y monitores temporales contratados." TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="• Actividades: consulte los horarios, monitores, cupos y zonas de verano." TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="• Los botones muestran una explicación adicional al mantener el cursor sobre ellos." TextWrapping="Wrap" Margin="0,4"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Ayuda contextual y seguridad" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Los campos marcados con * son obligatorios. Las acciones de eliminación solicitan confirmación antes de modificar los datos." TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="Los datos de este prototipo se mantienen únicamente durante la sesión y no se guardan en una base de datos." TextWrapping="Wrap" Margin="0,4"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Información de autoría" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Autores" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock Grid.Column="1" Text="Nombre Apellido 1 y Nombre Apellido 2" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Asignatura" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Interacción Persona-Ordenador I" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="Curso" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="2026/2027" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Text="Versión" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Prototipo 1.0 — 06/10/2026" Margin="0,4"/>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
