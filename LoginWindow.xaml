<Window x:Class="Trabajo_IPO.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso al complejo" Height="390" Width="470"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Gestión del complejo turístico" FontSize="24" FontWeight="Bold" Foreground="#17324D"/>
        <TextBlock Grid.Row="1" Text="Introduzca sus credenciales para continuar" Margin="0,8,0,24" Foreground="#52616B"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Usuario *" FontWeight="SemiBold"/>
            <TextBox x:Name="UsuarioTextBox" Height="32" Margin="0,5,0,14" ToolTip="Nombre de usuario del gestor"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock Text="Contraseña *" FontWeight="SemiBold"/>
            <PasswordBox x:Name="ContrasenaBox" Height="32" Margin="0,5,0,18" ToolTip="Contraseña de acceso"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Limpiar" Width="90" Height="32" Margin="0,0,8,0" Click="Limpiar_Click" ToolTip="Borrar las credenciales introducidas"/>
            <Button Content="Iniciar sesión" Width="125" Height="32" Click="IniciarSesion_Click" ToolTip="Validar las credenciales y abrir la aplicación"/>
        </StackPanel>
    </Grid>
</Window>
